{
  "entities": {
    "Dimension": {
      "title": "Dimension",
      "description": "A resilience dimension clustering multiple nodes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique dimension ID" },
        "name": { "type": "string", "description": "Name of the dimension" }
      },
      "required": ["id", "name"]
    },
    "NodeIndicator": {
      "title": "NodeIndicator",
      "description": "A node within the resilience network",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier of the node (same as abbr)" },
        "abbr": { "type": "string", "description": "Abbreviation of the node name" },
        "full_name": { "type": "string", "description": "Full descriptive name of the node" },
        "dimension_id": { "type": "string", "description": "ID of the parent dimension" },
        "theta": { "type": "number", "description": "Threshold" },
        "recovery_rate": { "type": "number", "description": "Recovery rate" }
      },
      "required": ["id", "abbr", "full_name", "dimension_id"]
    },
    "Edge": {
      "title": "Edge",
      "description": "A directed connection between source and target nodes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique edge identifier" },
        "source": { "type": "string", "description": "Source node abbreviation" },
        "target": { "type": "string", "description": "Target node abbreviation" }
      },
      "required": ["id", "source", "target"]
    },
    "SimulatorParams": {
      "title": "SimulatorParams",
      "description": "Global parameters and scenarios for the simulation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Configuration scenario ID (e.g., 'default')" },
        "T": { "type": "integer", "description": "Simulation time steps" },
        "theta": { "type": "number", "description": "Global default threshold value" },
        "gamma": { "type": "number", "description": "Scaling constant for interaction intensity" },
        "epsilon": { "type": "number", "description": "Tolerance value for convergence" },
        "rv": { "type": "number", "description": "Global default recovery rate" },
        "shocks": {
          "type": "array",
          "description": "List of active shocks applied to nodes"
        },
        "interventions": {
          "type": "array",
          "description": "List of active interventions scheduled"
        }
      },
      "required": ["id", "T", "theta", "gamma", "epsilon", "rv"]
    },
    "SavedNetworkConfig": {
      "title": "SavedNetworkConfig",
      "description": "A saved backup configuration of the resilience network",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Custom name assigned to the backup" },
        "savedAt": { "type": "string", "description": "Timestamp of the backup creation" },
        "domains": { "type": "array", "description": "Cloned domains list" },
        "nodes": { "type": "array", "description": "Cloned indicator nodes list" },
        "edges": { "type": "array", "description": "Cloned structural connections" },
        "params": { "$ref": "#/definitions/SimulatorParams", "description": "Associated simulation parameters" }
      },
      "required": ["name", "savedAt", "domains", "nodes", "edges", "params"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account and metadata mapped to unique username",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique username identifier" },
        "userName": { "type": "string", "description": "Unique username identifier" },
        "name": { "type": "string", "description": "User name" },
        "email": { "type": "string", "description": "User email address" },
        "role": { "type": "string", "description": "Role: user or admin" },
        "term": { "type": "string", "description": "Academic term" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" }
      },
      "required": ["id", "userName", "role"]
    }
  },
  "firestore": {
    "users/{userName}": {
      "schema": "UserProfile",
      "description": "User account profile mapped to unique username"
    },
    "users/{userName}/domains/{domainId}": {
      "schema": "Dimension",
      "description": "The user-specific resilience domains"
    },
    "users/{userName}/nodes/{nodeId}": {
      "schema": "NodeIndicator",
      "description": "The user-specific network nodes"
    },
    "users/{userName}/edges/{edgeId}": {
      "schema": "Edge",
      "description": "The user-specific directed network edges"
    },
    "users/{userName}/params/{paramId}": {
      "schema": "SimulatorParams",
      "description": "The user-specific simulation parameters"
    },
    "users/{userName}/saved_config/{configId}": {
      "schema": "SavedNetworkConfig",
      "description": "User's saved backup slots for custom network layouts"
    },
    "domains/{domainId}": {
      "schema": "Dimension",
      "description": "The global resilience domains"
    },
    "nodes/{nodeId}": {
      "schema": "NodeIndicator",
      "description": "The global network nodes"
    },
    "edges/{edgeId}": {
      "schema": "Edge",
      "description": "The global directed network edges"
    },
    "params/{paramId}": {
      "schema": "SimulatorParams",
      "description": "The global simulation parameter profiles"
    }
  }
}
